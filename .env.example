NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Local: path is relative to this backend directory.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Vercel: set this in the dashboard to the COMPLETE service-account JSON.
# Do not set GOOGLE_APPLICATION_CREDENTIALS on Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=
ALLOWED_ORIGINS=http://localhost:5001,http://127.0.0.1:5001
# Optional: read the existing centralized config instead of duplicating settings.
# UNITFLOW_CONFIG=../UnitFlow-1/config/unitflow.local.json
